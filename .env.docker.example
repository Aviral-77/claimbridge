# Copy this file to `.env.docker` and fill in your real GEMINI_API_KEY, then run:
#   docker compose --env-file .env.docker up --build
#
# This is dotenv format (KEY=value) — NOT the Windows-batch `.env` (`set VAR=...`)
# used by the local terminal workflow. Keep the two separate.
# `.env.docker` is gitignored because it holds your API key.

# --- LLM provider (same values as your local setup, minus the `set ` prefix) ---
LLM_PROVIDER=mock
GEMINI_API_KEY=enter_key

# --- Postgres (local dev creds; fine to leave as-is) ---
POSTGRES_USER=claimbridge
POSTGRES_PASSWORD=claimbridge
POSTGRES_DB=claimbridge

# --- MinIO / S3 (local dev creds; fine to leave as-is) ---
S3_BUCKET=claimbridge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
